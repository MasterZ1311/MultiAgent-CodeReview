# ============================================================
# cerberus</> (CodeVault AI) Configuration Environment Variables
# ============================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & API Keys
SECRET_KEY=cerberus_dev_secret_key_change_in_production_32chars
API_KEY_PREFIX=cvai_
RATE_LIMIT_PER_HOUR=100

# Database Configuration (SQLite default for zero-config local, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./cerberus.db
# DATABASE_URL=postgresql+asyncpg://codevault:dev_password@localhost:5432/codevault_db

# Cache Configuration (Falls back to high-performance in-memory LRU if Redis is unreachable)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800

# LLM Providers Configuration
LLM_PROVIDER=heuristic  # Options: watsonx, openai, ollama, heuristic
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# Active Agents (Comma-separated)
ENABLED_AGENTS=security,performance,quality,architecture,compliance

# Severity & Blocking Thresholds
SEVERITY_THRESHOLD=medium
BLOCKING_MODE=false
